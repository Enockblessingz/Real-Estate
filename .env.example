# ── Core ────────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DATABASE_URL="postgresql://nzuri:nzuri@localhost:5432/nzuri?schema=public"

# ── Auth ────────────────────────────────────────────────────────────────
# 32-byte random: `openssl rand -base64 32`
AUTH_SECRET="REPLACE_ME_WITH_32_BYTE_RANDOM_STRING"
AUTH_COOKIE_NAME="nzuri_session"
AUTH_SESSION_TTL_DAYS=30

# ── Realtime (Socket.io) ────────────────────────────────────────────────
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
SOCKET_INTERNAL_SECRET="REPLACE_ME"

# ── File storage ────────────────────────────────────────────────────────
# "local" | "cloudinary" | "s3"
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=./public/uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Payments (choose ONE) ───────────────────────────────────────────────
# Rwanda-first: Paypack (MTN MoMo + Airtel Money)
PAYPACK_CLIENT_ID=
PAYPACK_CLIENT_SECRET=
PAYPACK_WEBHOOK_SECRET=
PAYPACK_ENV=sandbox   # sandbox | production

# Stripe (international cards)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Business rules (verified against your live pricing — DO NOT guess) ──
PROPERTY_ACCESS_FEE_RWF=5000
FEATURED_LISTING_FEE_RWF=25000
FEATURED_LISTING_DURATION_DAYS=30

# ── Email ───────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Nzuri <noreply@nzuri.rw>"

# ── Admin bootstrap ─────────────────────────────────────────────────────
ADMIN_EMAIL=admin@nzuri.rw
ADMIN_INITIAL_PASSWORD=REPLACE_ME
